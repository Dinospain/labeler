generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Label {
  id             Int       @id @default(autoincrement())
  productName    String
  weight         String?
  manufacturedAt DateTime?
  packagedAt     DateTime?
  expiresAt      DateTime?
  shelfLife      String?
  composition    String?
  proteins100g   Float?
  fats100g       Float?
  carbs100g      Float?
  standard       String?
  address        String?
  mchsInfo       String?
  website        String?
  barcode        String?
  barcodeType    String    @default("ean13")
  extra          Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // принадлежит аккаунту
  account        Account   @relation(fields: [accountId], references: [id])
  accountId      Int

  // связь с папкой внутри аккаунта
  folderId Int?
  folder   Folder? @relation(fields: [folderId], references: [id])

  @@index([folderId])
}

model Template {
  id        Int      @id @default(autoincrement())
  name      String
  html      String // Handlebars-шаблон
  isCurrent Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id])
  accountId Int
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String
  account   Account  @relation(fields: [accountId], references: [id])
  accountId Int
  labels    Label[]
  createdAt DateTime @default(now())
}

model Account {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique // для удобного указания в заголовке/урле
  apiKey    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folders   Folder[]
  labels    Label[]
  templates Template[]
}
